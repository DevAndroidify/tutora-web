  "info": {
    "title": "Tutora Admin API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "OpenCaseDto": {
        "type": "object",
        "properties": {
          "subjectUserId": {
            "type": "string",
            "format": "uuid"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "subjectUserId",
          "note"
        ]
      },
      "CaseActionDto": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "DISMISS",
              "WARN",
              "RESTRICT_POSTING",
              "RESTRICT_BIDDING",
              "SUSPEND",
              "BAN"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Shown to the member for sanctions; kept in the audit log."
          },
          "durationDays": {
            "type": "number",
            "minimum": 1,
            "maximum": 365,
            "description": "Required for SUSPEND and RESTRICT_*."
          }
        },
        "required": [
          "action",
          "reason"
        ]
      },
      "LiftDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "ResolveDisputeDto": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "RELEASE",
              "REFUND"
            ]
          }
        },
        "required": [
          "note",
          "outcome"
        ]
      },
      "NoteDto": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string"
          }
        },
        "required": [
          "note"
        ]
      },
      "PayoutDto": {
        "type": "object",
        "properties": {
          "tutorUserId": {
            "type": "string",
            "format": "uuid"
          },
          "amountPaise": {
            "type": "number",
            "description": "Paise already sent to the tutor by UPI."
          },
          "reference": {
            "type": "string",
            "description": "UPI transaction reference (UTR)."
          }
        },
        "required": [
          "tutorUserId",
          "amountPaise",
          "reference"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "asha@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ApproveTutorDto": {
        "type": "object",
        "properties": {
          "badge": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "EXPERT"
            ]
          }
        },
        "required": [
          "badge"
        ]
      },
      "RejectDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          }
        },
        "required": [
          "reason"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Fitness & Wellness"
          },
          "slug": {
            "type": "string",
            "example": "fitness-wellness"
          },
          "description": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "format": "uuid",
            "description": "Makes this a sub-category."
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "CreateSkillDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Options Trading Basics"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "learnerNotice": {
            "type": "string",
            "description": "Shown to learners before booking."
          }
        },
        "required": [
          "categoryId",
          "name"
        ]
      },
      "UpdateSkillDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "learnerNotice": {
            "type": "object",
            "nullable": true,
            "description": "null removes the notice."
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "CreateTopicDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Option Greeks"
          },
          "slug": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "name"
        ]
      },
      "ApproveSuggestionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Override the suggested name."
          },
          "slug": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "description": "Move to another category."
          },
          "learnerNotice": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}