  "info": {
    "title": "Tutora Student API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "asha@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "example": "correct-horse-battery"
          },
          "fullName": {
            "type": "string",
            "example": "Asha Verma"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "asha@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateRequestDto": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string",
            "format": "uuid"
          },
          "topicId": {
            "type": "string",
            "format": "uuid"
          },
          "level": {
            "type": "string",
            "enum": [
              "BEGINNER",
              "INTERMEDIATE",
              "ADVANCED"
            ]
          },
          "title": {
            "type": "string",
            "example": "How do I read candlestick patterns?"
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "preferredLanguage": {
            "type": "string",
            "example": "Hindi"
          },
          "budgetHintPaise": {
            "type": "number",
            "description": "Budget hint in paise (₹500 = 50000)."
          }
        },
        "required": [
          "skillId",
          "level",
          "title",
          "description"
        ]
      },
      "UpdateRequestDto": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string",
            "format": "uuid"
          },
          "topicId": {
            "type": "string",
            "format": "uuid"
          },
          "level": {
            "type": "string",
            "enum": [
              "BEGINNER",
              "INTERMEDIATE",
              "ADVANCED"
            ]
          },
          "title": {
            "type": "string",
            "example": "How do I read candlestick patterns?"
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "preferredLanguage": {
            "type": "string",
            "example": "Hindi"
          },
          "budgetHintPaise": {
            "type": "number",
            "description": "Budget hint in paise (₹500 = 50000)."
          }
        }
      },
      "AttachDto": {
        "type": "object",
        "properties": {
          "objectKey": {
            "type": "string",
            "description": "objectKey returned by POST /student/uploads/presign."
          },
          "fileName": {
            "type": "string",
            "example": "question.png"
          }
        },
        "required": [
          "objectKey",
          "fileName"
        ]
      },
      "ConfirmCheckoutDto": {
        "type": "object",
        "properties": {
          "razorpay_order_id": {
            "type": "string"
          },
          "razorpay_payment_id": {
            "type": "string"
          },
          "razorpay_signature": {
            "type": "string"
          }
        },
        "required": [
          "razorpay_order_id",
          "razorpay_payment_id",
          "razorpay_signature"
        ]
      },
      "ConsentDto": {
        "type": "object",
        "properties": {
          "granted": {
            "type": "boolean",
            "description": "true = allow recording this session."
          }
        },
        "required": [
          "granted"
        ]
      },
      "DisputeDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "TUTOR_ABSENT_OR_LATE",
              "POOR_QUALITY",
              "NOT_AS_DESCRIBED",
              "TECHNICAL_ISSUES",
              "MISCONDUCT",
              "OTHER"
            ]
          },
          "details": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "reason"
        ]
      },
      "ReviewDto": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "comment": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "rating"
        ]
      },
      "QuizAnswersDto": {
        "type": "object",
        "properties": {
          "answers": {
            "description": "Chosen option index per question, or [rating] for a self-check.",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "answers"
        ]
      },
      "ReportDto": {
        "type": "object",
        "properties": {
          "subjectUserId": {
            "type": "string",
            "format": "uuid",
            "description": "The member being reported."
          },
          "reason": {
            "type": "string",
            "enum": [
              "HARASSMENT",
              "OFF_PLATFORM_PAYMENT",
              "NO_SHOW",
              "MISLEADING_CLAIMS",
              "INAPPROPRIATE_CONTENT",
              "FINANCIAL_TIPS",
              "SPAM",
              "OTHER"
            ]
          },
          "entityType": {
            "type": "string",
            "enum": [
              "USER",
              "TUTOR_PROFILE",
              "TUTOR_SKILL",
              "LEARNING_REQUEST",
              "BID",
              "SESSION"
            ],
            "description": "What the report is about, if specific."
          },
          "entityId": {
            "type": "string"
          },
          "details": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "subjectUserId",
          "reason"
        ]
      },
      "PresignDto": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "example": "image/png"
          },
          "sizeBytes": {
            "type": "number",
            "example": 120000
          }
        },
        "required": [
          "contentType",
          "sizeBytes"
        ]
      },
      "ModeEventDto": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "FULL_VIDEO",
              "AUDIO_ONLY",
              "WHITEBOARD_ONLY"
            ]
          },
          "downlinkKbps": {
            "type": "number",
            "description": "Client-measured downlink, kbps."
          },
          "reason": {
            "type": "string",
            "example": "poor-connection"
          }
        },
        "required": [
          "mode"
        ]
      },
      "SnapshotDto": {
        "type": "object",
        "properties": {
          "objectKey": {
            "type": "string",
            "description": "objectKey from .../whiteboard-snapshots/presign"
          },
          "isFinal": {
            "type": "boolean",
            "description": "Mark as the final board for the replay."
          }
        },
        "required": [
          "objectKey"
        ]
      }
    }
  }
}