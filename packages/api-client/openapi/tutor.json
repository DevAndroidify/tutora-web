    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "asha@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "example": "correct-horse-battery"
          },
          "fullName": {
            "type": "string",
            "example": "Asha Verma"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "asha@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpsertTutorProfileDto": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "string",
            "maxLength": 120,
            "example": "Ex-NSE analyst teaching charting for beginners"
          },
          "bio": {
            "type": "string",
            "maxLength": 2000
          },
          "experienceYears": {
            "type": "number",
            "minimum": 0,
            "maximum": 60
          },
          "languages": {
            "example": [
              "English",
              "Hindi"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "payoutUpiId": {
            "type": "string",
            "example": "tutor.name@okaxis",
            "description": "Private. Used for payouts."
          }
        }
      },
      "UpsertTutorSkillDto": {
        "type": "object",
        "properties": {
          "experienceYears": {
            "type": "number",
            "minimum": 0,
            "maximum": 60
          },
          "summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1000,
            "description": "What you teach and how."
          },
          "evidenceLinks": {
            "description": "Up to 5 https links: portfolio, certificates, channel, published work.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "summary",
          "evidenceLinks"
        ]
      },
      "SuggestSkillDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "example": "Options Trading Basics"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "categoryId",
          "name"
        ]
      },
      "CreateBidDto": {
        "type": "object",
        "properties": {
          "seatPricePaise": {
            "type": "number",
            "description": "Price per seat in paise (₹499 = 49900).",
            "example": 49900
          },
          "proposedStartAt": {
            "type": "string",
            "example": "2026-11-05T14:30:00.000Z"
          },
          "durationMinutes": {
            "type": "number",
            "minimum": 15,
            "maximum": 240,
            "example": 60
          },
          "approachText": {
            "type": "string",
            "maxLength": 2000,
            "description": "Required unless approachMediaKey is given."
          },
          "approachMediaKey": {
            "type": "string",
            "description": "objectKey from POST /tutor/uploads/presign (about 30 seconds)."
          }
        },
        "required": [
          "seatPricePaise",
          "proposedStartAt",
          "durationMinutes"
        ]
      },
      "UpdateBidDto": {
        "type": "object",
        "properties": {
          "seatPricePaise": {
            "type": "number",
            "description": "Price per seat in paise (₹499 = 49900).",
            "example": 49900
          },
          "proposedStartAt": {
            "type": "string",
            "example": "2026-11-05T14:30:00.000Z"
          },
          "durationMinutes": {
            "type": "number",
            "minimum": 15,
            "maximum": 240,
            "example": 60
          },
          "approachText": {
            "type": "string",
            "maxLength": 2000,
            "description": "Required unless approachMediaKey is given."
          },
          "approachMediaKey": {
            "type": "string",
            "description": "objectKey from POST /tutor/uploads/presign (about 30 seconds)."
          }
        }
      },
      "ConsentDto": {
        "type": "object",
        "properties": {
          "granted": {
            "type": "boolean",
            "description": "true = allow recording this session."
          }
        },
        "required": [
          "granted"
        ]
      },
      "ReportDto": {
        "type": "object",
        "properties": {
          "subjectUserId": {
            "type": "string",
            "format": "uuid",
            "description": "The member being reported."
          },
          "reason": {
            "type": "string",
            "enum": [
              "HARASSMENT",
              "OFF_PLATFORM_PAYMENT",
              "NO_SHOW",
              "MISLEADING_CLAIMS",
              "INAPPROPRIATE_CONTENT",
              "FINANCIAL_TIPS",
              "SPAM",
              "OTHER"
            ]
          },
          "entityType": {
            "type": "string",
            "enum": [
              "USER",
              "TUTOR_PROFILE",
              "TUTOR_SKILL",
              "LEARNING_REQUEST",
              "BID",
              "SESSION"
            ],
            "description": "What the report is about, if specific."
          },
          "entityId": {
            "type": "string"
          },
          "details": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "subjectUserId",
          "reason"
        ]
      },
      "PresignDto": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "example": "image/png"
          },
          "sizeBytes": {
            "type": "number",
            "example": 120000
          }
        },
        "required": [
          "contentType",
          "sizeBytes"
        ]
      },
      "ModeEventDto": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "FULL_VIDEO",
              "AUDIO_ONLY",
              "WHITEBOARD_ONLY"
            ]
          },
          "downlinkKbps": {
            "type": "number",
            "description": "Client-measured downlink, kbps."
          },
          "reason": {
            "type": "string",
            "example": "poor-connection"
          }
        },
        "required": [
          "mode"
        ]
      },
      "SnapshotDto": {
        "type": "object",
        "properties": {
          "objectKey": {
            "type": "string",
            "description": "objectKey from .../whiteboard-snapshots/presign"
          },
          "isFinal": {
            "type": "boolean",
            "description": "Mark as the final board for the replay."
          }
        },
        "required": [
          "objectKey"
        ]
      },
      "TutorNotesDto": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "keyPoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "summary",
          "keyPoints"
        ]
      },
      "CreatePoolBidDto": {
        "type": "object",
        "properties": {
          "seatPricePaise": {
            "type": "number",
            "description": "Price per seat in paise (₹499 = 49900).",
            "example": 49900
          },
          "proposedStartAt": {
            "type": "string",
            "example": "2026-11-05T14:30:00.000Z"
          },
          "durationMinutes": {
            "type": "number",
            "minimum": 15,
            "maximum": 240,
            "example": 60
          },
          "approachText": {
            "type": "string",
            "maxLength": 2000,
            "description": "Required unless approachMediaKey is given."
          },
          "approachMediaKey": {
            "type": "string",
            "description": "objectKey from POST /tutor/uploads/presign (about 30 seconds)."
          },
          "minSeats": {
            "type": "number",
            "minimum": 2,
            "example": 2,
            "description": "The session runs only if at least this many learners pay."
          },
          "maxSeats": {
            "type": "number",
            "minimum": 2,
            "example": 5,
            "description": "At most this many learners can pay (<= POOL_MAX_SEATS)."
          }
        },
        "required": [
          "seatPricePaise",
          "proposedStartAt",
          "durationMinutes",
          "minSeats",
          "maxSeats"
        ]
      }
    }
  }
}