{
  "name": "tutora-web",
  "private": true,
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach -Apiv --include '@tutora/*-app' run dev",
    "dev:student": "yarn workspace @tutora/student-app dev",
    "dev:tutor": "yarn workspace @tutora/tutor-app dev",
    "dev:admin": "yarn workspace @tutora/admin-app dev",
    "build": "yarn workspaces foreach -Apt --include '@tutora/*-app' run build",
    "lint": "eslint \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/scripts/**/*.mjs\" \"e2e/**/*.ts\" \"scripts/*.mjs\"",
    "typecheck": "yarn workspaces foreach -Ap run typecheck",
    "test": "vitest run",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.{ts,tsx,css}\"",
    "api:sync": "yarn workspace @tutora/api-client sync",
    "e2e": "yarn workspace @tutora/e2e test",
    "budgets": "node scripts/check-budgets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
